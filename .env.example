# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AgentOps environment guards (staging-only — server + client badge)
AGENTOPS_ENVIRONMENT=staging
AGENTOPS_STAGING_SUPABASE_PROJECT_REF=ydppcpbxrvvardeslzrk
VITE_AGENTOPS_STAGING_SUPABASE_PROJECT_REF=ydppcpbxrvvardeslzrk
AGENTOPS_ALLOW_NON_STAGING=false
AGENTOPS_PRODUCTION_BLOCKED=true
VITE_AGENTOPS_PRODUCTION_BLOCKED=true
VITE_AGENTOPS_ENVIRONMENT=staging
AGENTOPS_QA_BASE_URL=https://YOUR-STAGING-DEPLOY-URL
AGENTOPS_AUDIT_BASE=https://YOUR-STAGING-DEPLOY-URL

# AgentOps local LLM (Ollama — all chats use server proxy /api/agentops/llm)# Start Ollama locally, then pull a model: ollama pull llama3.2
VITE_AGENTOPS_LLM_ENABLED=true
VITE_AGENTOPS_LLM_BASE_URL=http://127.0.0.1:11434
VITE_AGENTOPS_LLM_MODEL=llama3.2
# API style retained for docs; browser calls server proxy only (no direct Ollama/CORS)
VITE_AGENTOPS_LLM_API_STYLE=ollama

# Server-side LLM runtime (required for Council, Agent, and Issue chats)
AGENTOPS_LLM_RUNTIME_ACTIVE=true
# Provider: ollama (local) or doubao_ark (Volcano Ark cloud — staging)
# AGENTOPS_LLM_PROVIDER=ollama
AGENTOPS_LLM_BASE_URL=http://127.0.0.1:11434
AGENTOPS_LLM_MODEL=llama3.2

# Doubao Ark (server-side only — use on Vercel staging when Ollama is unavailable)
# AGENTOPS_LLM_PROVIDER=doubao_ark
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-0-pro-260215

# AgentOps Hermes (server-side proxy — set on Vercel / local vercel dev, not in browser secrets)
VITE_AGENTOPS_HERMES_ENABLED=true
HERMES_RUNTIME_ACTIVE=true
HERMES_OWNER_APPROVED=true
HERMES_STAGING_ENDPOINT=http://127.0.0.1:11434
HERMES_LLM_MODEL=llama3.2
HERMES_TIMEOUT_MS=120000
# Optional route auth header x-agentops-hermes-secret
# HERMES_INTERNAL_SECRET=

# AgentOps Supertonic / Supertone TTS (server-side only — Chat & Voice Tools Hub)
# Cloud Supertone API: https://docs.supertoneapi.com
# SUPERTONE_API_KEY=
# SUPERTONE_VOICE_ID=
# SUPERTONE_API_BASE_URL=https://supertoneapi.com
# SUPERTONE_TTS_LANGUAGE=en
# SUPERTONE_TTS_MODEL=sona_speech_1
# SUPERTONE_TTS_OUTPUT_FORMAT=mp3

# Local Supertonic serve (alternative): pip install 'supertonic[serve]' && supertonic serve
# SUPERTONIC_LOCAL_BASE_URL=http://127.0.0.1:7788
# SUPERTONIC_LOCAL_VOICE=M1

# Gates — manual test only; no production TTS unless explicitly allowed
# AGENTOPS_SUPERTONIC_TTS_ACTIVE=true
# AGENTOPS_SUPERTONIC_OWNER_APPROVED=true
# AGENTOPS_SUPERTONIC_TTS_PRODUCTION_ALLOWED=false

# AgentOps Doubao / Volcengine streaming ASR (server-side only — Chat & Voice Tools Hub)
# Docs: Volcengine OpenSpeech SAUC bigmodel WebSocket endpoints
# New console auth:
# DOUBAO_ASR_API_KEY=
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# Endpoint mode:
# DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# DOUBAO_ASR_MODE=bidirectional_async
# Control gates:
# AGENTOPS_DOUBAO_ASR_ACTIVE=false
# AGENTOPS_DOUBAO_ASR_OWNER_APPROVED=false
# AGENTOPS_DOUBAO_ASR_PRODUCTION_ALLOWED=false
# Optional old console auth:
# DOUBAO_ASR_APP_KEY=
# DOUBAO_ASR_ACCESS_KEY=
# Optional defaults:
# DOUBAO_ASR_LANGUAGE=zh-CN
# DOUBAO_ASR_AUDIO_FORMAT=wav
# DOUBAO_ASR_SAMPLE_RATE=16000

# AgentOps OpenSpeech / Doubao ASR STT (server-side only — Chat & Voice Tools Hub)
# These may reuse DOUBAO_TTS_APP_ID and DOUBAO_TTS_API_KEY locally, but secrets must stay in .env.local or Vercel env only.
# DOUBAO_STT_APP_ID=
# DOUBAO_STT_ACCESS_TOKEN=
# DOUBAO_STT_HTTP_API_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
# DOUBAO_STT_API_URL=https://openspeech.bytedance.com/api/v3/sauc/bigmodel
# DOUBAO_STT_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# DOUBAO_STT_CLUSTER=volcano_tts
# DOUBAO_STT_RESOURCE_ID=volc.bigasr.auc_turbo
# DOUBAO_STT_DEFAULT_LANGUAGE=en-US
# DOUBAO_STT_AUDIO_FORMAT=wav
# DOUBAO_STT_ACTIVE=false
# DOUBAO_STT_OWNER_APPROVED=false
# DOUBAO_STT_PRODUCTION_ALLOWED=false

# AgentOps Doubao / Volcengine OpenSpeech TTS (server-side only — Chat & Voice Tools Hub)
# DOUBAO_TTS_APP_ID=
# DOUBAO_TTS_API_KEY=              # OpenSpeech access token (Bearer;token header)
# DOUBAO_TTS_ACCESS_TOKEN=         # Optional alias for DOUBAO_TTS_API_KEY
# DOUBAO_TTS_VOICE_ID=en_female_dacey_uranus_bigtts
# DOUBAO_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
# DOUBAO_TTS_CLUSTER=volcano_tts
# DOUBAO_TTS_OUTPUT_FORMAT=mp3
# DOUBAO_TTS_LANGUAGE=zh-CN
# Optional local serve:
# DOUBAO_TTS_LOCAL_BASE_URL=http://127.0.0.1:7790
# DOUBAO_TTS_LOCAL_VOICE=M1
# Control gates:
# AGENTOPS_DOUBAO_TTS_ACTIVE=false
# AGENTOPS_DOUBAO_TTS_OWNER_APPROVED=false
# AGENTOPS_DOUBAO_TTS_PRODUCTION_ALLOWED=false
