# Hermes staging environment template — EXAMPLE ONLY
# Copy to .env.local for local development. Do NOT commit real secrets.
# API key must be stored in local/Vercel env only — never in git.
# HERMES_RUNTIME_ACTIVE must stay false until owner sign-off (hermes-owner-signoff-template.md).

HERMES_RUNTIME_ACTIVE=false
HERMES_STAGING_ENDPOINT=
HERMES_API_KEY=
HERMES_TIMEOUT_MS=15000
HERMES_ALLOWED_MODES=issue_clarification,prompt_refinement,risk_review,next_step_recommendation,cursor_report_synthesis,archive_lesson_extraction
HERMES_OWNER_APPROVED=false
