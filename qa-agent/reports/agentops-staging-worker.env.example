# AiXia AgentOps staging worker — PLACEHOLDERS ONLY
# Copy to a host-local path. Never commit real secrets.
# Worker host must be staging-only.

AGENTOPS_ENVIRONMENT=staging
AGENTOPS_PRODUCTION_BLOCKED=true
STAGING_APP_URL=https://ai-xia-staging.vercel.app
STAGING_SUPABASE_URL=<staging-supabase-url>
STAGING_SUPABASE_SERVICE_ROLE_KEY=<worker-host-only>
AGENTOPS_WORKER_SECRET=<worker-secret>
AGENTOPS_WORKER_ID=<stable-worker-id>
AGENTOPS_STAGING_WORKER_INTERVAL_MS=60000
AGENTOPS_BROWSER_QA_STORAGE_STATE=<local-path-not-committed>

# Phase D-C — private staging artifact upload (disabled unless explicitly true)
AGENTOPS_ARTIFACT_UPLOAD_ENABLED=false
AGENTOPS_ARTIFACT_BUCKET=agentops-artifacts-staging
AGENTOPS_ARTIFACT_RETENTION_DAYS=14

# Phase D-D — alert fanout (disabled by default; worker-host only)
AGENTOPS_ALERT_FANOUT_ENABLED=false
AGENTOPS_ALERT_CHANNEL=log
AGENTOPS_ALERT_WEBHOOK_URL=<staging-alert-webhook-url>
AGENTOPS_ALERT_WEBHOOK_SECRET=<worker-host-only>
AGENTOPS_ALERT_MIN_LEVEL=warning
AGENTOPS_ALERT_RATE_LIMIT_MINUTES=30
