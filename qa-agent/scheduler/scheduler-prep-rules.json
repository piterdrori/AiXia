{
  "version": "1.0.0",
  "environment": "staging-only",
  "stagingProjectRef": "ydppcpbxrvvardeslzrk",
  "schedulerStatus": "preparation-only",
  "active": false,
  "allowedFutureRunModes": [
    "foundation",
